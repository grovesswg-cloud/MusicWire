# MusicWire Automation — Environment Variables
# Copy to .env for local use. Never commit .env.

# Required
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — enables artist portrait sourcing via Last.fm
LASTFM_API_KEY=your_lastfm_key_here

# Optional — additional news sources
NEWS_API_KEY=your_newsapi_key_here

# Optional — override Gemini model (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-1.5-pro
